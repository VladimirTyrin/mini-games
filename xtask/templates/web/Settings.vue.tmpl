<script setup lang="ts">
import { computed } from "vue";

import NumberField from "@/components/form/NumberField.vue";
import type { GameSettings } from "@/proto/minigames/v2/game_pb";

const settings = defineModel<GameSettings>({ required: true });
const value = computed(() => (settings.value.game.case === "{{camel}}" ? settings.value.game.value : null));

function setTarget(target: number): void {
  if (!value.value) return;
  settings.value = { ...settings.value, game: { case: "{{camel}}", value: { ...value.value, target } } };
}
</script>

<template>
  <NumberField v-if="value" label="Target" :model-value="value.target" @update:model-value="setTarget" />
</template>
