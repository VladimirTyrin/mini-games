use mg_core::CommandError;

const MAX_ADD: u32 = 3;

/// The shared total after adding `amount`, capped at `target`.
pub(crate) fn add_to_total(total: u32, amount: u32, target: u32) -> Result<u32, CommandError> {
    if !(1..=MAX_ADD).contains(&amount) {
        return Err(CommandError::Illegal("add 1, 2 or 3"));
    }
    Ok(total.saturating_add(amount).min(target))
}
