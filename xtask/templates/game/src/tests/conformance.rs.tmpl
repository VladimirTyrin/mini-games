use mg_core::conformance::{self, Conformance, Setup};
use mg_core::{CoreRng, PlayerSpec, Slot};

use crate::{Command, RawSettings, Target, {{Pascal}}};

impl Conformance for {{Pascal}} {
    fn sample_setups() -> Vec<Setup<Self>> {
        vec![
            Setup::new(RawSettings::default(), vec![PlayerSpec::HUMAN]),
            Setup::new(RawSettings { target: Target::MIN }, vec![PlayerSpec::HUMAN; 2]),
            Setup::new(RawSettings { target: Target::MAX }, vec![PlayerSpec::HUMAN; 4]),
        ]
    }

    fn invalid_setups() -> Vec<Setup<Self>> {
        vec![
            Setup::new(RawSettings { target: 0 }, vec![PlayerSpec::HUMAN]),
            Setup::new(RawSettings { target: Target::MIN - 1 }, vec![PlayerSpec::HUMAN]),
            Setup::new(RawSettings { target: Target::MAX + 1 }, vec![PlayerSpec::HUMAN]),
            Setup::new(RawSettings { target: u32::MAX }, vec![PlayerSpec::HUMAN]),
            Setup::new(RawSettings::default(), vec![]),
            Setup::new(RawSettings::default(), vec![PlayerSpec::HUMAN; 5]),
            Setup::new(RawSettings::default(), vec![PlayerSpec::HUMAN, PlayerSpec::BOT]),
        ]
    }

    fn arbitrary_command(_game: &Self, _slot: Slot, rng: &mut CoreRng) -> Command {
        Command::Add(rng.below(5))
    }
}

#[test]
fn passes_conformance() {
    conformance::run_all::<{{Pascal}}>(20);
}

/// Pins the rules: if this value changes, a rule changed — update it deliberately. A new game
/// starts unpinned, so this test fails until the value it prints is copied here.
const GOLDEN_HASH: u64 = 0;

#[test]
fn scripted_hash_is_pinned() {
    let setup = Setup::<{{Pascal}}>::new(RawSettings::default(), vec![PlayerSpec::HUMAN; 2]);
    let hash = conformance::scripted_hash(&setup, 42);
    assert_eq!(hash, GOLDEN_HASH, "pin GOLDEN_HASH = {hash:#018x}");
}
