{
  "name": "mini-games-client",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node build/generate-proto.mjs && node build/build-wasm.mjs",
    "generate:proto": "node build/generate-proto.mjs",
    "build:wasm": "node build/build-wasm.mjs",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "vue-tsc --noEmit && vite build && node build/check-size.mjs",
    "preview": "vite preview",
    "pretest": "npm run generate",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "android:sync": "node build/android.mjs sync",
    "android:apk": "node build/android.mjs apk release",
    "android:apk:debug": "node build/android.mjs apk debug"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-social-login": "8.7.11",
    "@capgo/capacitor-updater": "8.54.2",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@capacitor/cli": "8.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
