# Copy to deploy.local.env (not in git) and point at this machine's toolchain.
# The Android build needs a JDK and the SDK; the musl server build needs zig on PATH.
export JAVA_HOME="/c/Program Files/Eclipse Adoptium/jdk-21.0.13.9-hotspot"
export ANDROID_HOME="$LOCALAPPDATA/Android/Sdk"
export PATH="$JAVA_HOME/bin:/c/Users/me/tools/zig-x86_64-windows-0.14.1:$PATH"
