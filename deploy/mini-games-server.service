[Unit]
Description=Mini Games Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mini-games-server
# MG_SESSION_SECRET, MG_GOOGLE_CLIENT_ID, MG_ALLOW_GUESTS, MG_BOT_KEYS, MG_VAPID_*,
# MG_FCM_SERVICE_ACCOUNT (written by deploy.sh).
EnvironmentFile=/etc/mini-games-server.env
Environment=MG_LISTEN=127.0.0.1:5000
# Friends and push targets. systemd keeps /var/lib/mini-games-server across deploys and gives
# the dynamic user write access to it; the server migrates the database at start.
StateDirectory=mini-games-server
Environment=MG_DATABASE=/var/lib/mini-games-server/mini-games.db
# mimalloc asks for transparent huge pages for its arena: each touched 2 MiB page becomes
# resident, ~10 MiB at idle instead of ~1 MiB.
Environment=MIMALLOC_ALLOW_THP=0
ExecStart=/opt/mini-games-server/mini_games_server
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

# Hardening: the server reads its own binary, writes only its state directory and listens on
# localhost.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
