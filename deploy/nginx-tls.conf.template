# Rendered by deploy.sh (mode: tls).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __SERVER_NAME__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # The Android app may be pointed at a bare IP over plain ws:// (its Settings allow it).
    include /etc/nginx/snippets/mini-games-ws.conf;

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    # Off until Ubuntu ships nginx with the NGINX2Root fixes (CVE-2026-123007, CVE-2026-123633:
    # code execution through HTTP/2, nginx 1.9.5-1.31.8). The app needs nothing of HTTP/2: the
    # WebSocket is HTTP/1.1 anyway. Turn it back on with the patched package.
    http2 off;
    server_name __SERVER_NAME__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:2m;
    ssl_session_timeout 1d;

    include /etc/nginx/snippets/mini-games-locations.conf;
}
